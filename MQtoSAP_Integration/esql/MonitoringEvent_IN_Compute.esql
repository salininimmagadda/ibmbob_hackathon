BROKER SCHEMA subflows

/**
 * Monitoring Event IN Subflow - ESQL Compute Module
 * Purpose: Create monitoring event with status code "IN" after input node
 * Captures business unique ID and other monitoring data
 */

CREATE COMPUTE MODULE MonitoringEvent_IN_Compute
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		-- Copy input message to output
		SET OutputRoot = InputRoot;
		
		-- Generate unique correlation ID if not present
		DECLARE correlationId CHARACTER;
		IF InputLocalEnvironment.WrittenDestination.MQ.DestinationData.msgId IS NOT NULL THEN
			SET correlationId = CAST(InputLocalEnvironment.WrittenDestination.MQ.DestinationData.msgId AS CHARACTER);
		ELSE
			SET correlationId = CAST(CURRENT_TIMESTAMP AS CHARACTER) || '_' || CAST(RAND() AS CHARACTER);
		END IF;
		
		-- Extract business unique ID from message
		DECLARE businessUniqueId CHARACTER;
		DECLARE messageBody REFERENCE TO InputRoot.JSON.Data;
		
		-- Try to extract business ID from various possible locations
		IF EXISTS(messageBody.businessId[]) THEN
			SET businessUniqueId = messageBody.businessId;
		ELSEIF EXISTS(messageBody.orderId[]) THEN
			SET businessUniqueId = messageBody.orderId;
		ELSEIF EXISTS(messageBody.transactionId[]) THEN
			SET businessUniqueId = messageBody.transactionId;
		ELSEIF EXISTS(messageBody.id[]) THEN
			SET businessUniqueId = messageBody.id;
		ELSE
			SET businessUniqueId = correlationId;
		END IF;
		
		-- Create monitoring event structure in Environment
		CREATE LASTCHILD OF Environment.MonitoringEvent AS monEvent NAMESPACE '';
		
		-- Set monitoring event fields
		SET monEvent.StatusCode = 'IN';
		SET monEvent.BusinessUniqueId = businessUniqueId;
		SET monEvent.CorrelationId = correlationId;
		SET monEvent.Timestamp = CURRENT_TIMESTAMP;
		SET monEvent.FlowName = MessageFlowLabel;
		SET monEvent.NodeName = 'MonitoringEvent_IN';
		SET monEvent.MessageId = CAST(InputLocalEnvironment.WrittenDestination.MQ.DestinationData.msgId AS CHARACTER);
		
		-- Capture additional metadata
		SET monEvent.SourceQueue = InputLocalEnvironment.Destination.MQ.DestinationData.queueName;
		SET monEvent.MessageFormat = InputRoot.Properties.MessageFormat;
		SET monEvent.MessageSize = LENGTH(CAST(InputRoot.BLOB.BLOB AS CHARACTER));
		SET monEvent.Encoding = InputRoot.Properties.Encoding;
		SET monEvent.CodedCharSetId = InputRoot.Properties.CodedCharSetId;
		
		-- Log monitoring event (optional - can be sent to monitoring queue)
		CALL LogMonitoringEvent(monEvent);
		
		RETURN TRUE;
	END;

	/**
	 * Log monitoring event to application log
	 */
	CREATE PROCEDURE LogMonitoringEvent(IN monEvent REFERENCE)
	BEGIN
		DECLARE logMessage CHARACTER;
		SET logMessage = '[MONITORING-IN] ' ||
			'Status=' || monEvent.StatusCode ||
			', BusinessId=' || monEvent.BusinessUniqueId ||
			', CorrelationId=' || monEvent.CorrelationId ||
			', Flow=' || monEvent.FlowName ||
			', Timestamp=' || CAST(monEvent.Timestamp AS CHARACTER);
		
		-- Write to user trace
		CALL CopyMessageHeaders();
		SET Environment.Variables.MonitoringLog = logMessage;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;

END MODULE;